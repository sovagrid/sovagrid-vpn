# Managed by SovaGrid optional Amnezia installer
[Unit]
Description=SovaGrid optional Amnezia control broker
Requires=sovagrid-amnezia-control.socket
After=sovagrid-amnezia-control.socket docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/libexec/sovagrid-amnezia-broker
User=root
Group=root
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sovagrid-vpn
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
TasksMax=64
MemoryMax=256M
